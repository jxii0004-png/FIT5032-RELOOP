rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /recyclingPlans/{uid}/items/{id} {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      function validPlan() {
        let p = request.resource.data;
        return p.keys().hasAll(['itemId', 'quantity', 'method', 'date', 'location', 'status', 'createdAt', 'completedAt']) &&
          p.keys().hasOnly(['itemId', 'quantity', 'method', 'date', 'location', 'status', 'createdAt', 'completedAt']) &&
          p.itemId is int && p.itemId >= 1 && p.itemId <= 12 &&
          p.quantity is int && p.quantity >= 1 && p.quantity <= 1000 &&
          p.method in ['reuse', 'repair', 'recycle'] &&
          p.date is string && (p.date == '' || p.date.matches('^(20[0-9]{2}|2100)-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')) &&
          p.location is string && p.location.size() <= 200 && p.createdAt is timestamp &&
          ((p.status == 'planned' && p.completedAt == null) ||
           (p.status == 'completed' && p.completedAt is timestamp && p.completedAt <= request.time));
      }
      allow read, delete: if owner();
      allow create: if owner() && validPlan() && request.resource.data.status == 'planned' &&
        request.resource.data.completedAt == null && request.resource.data.createdAt == request.time;
      allow update: if owner() && validPlan() && request.resource.data.createdAt == resource.data.createdAt &&
        (request.resource.data.status == 'planned' ||
         (resource.data.status == 'completed' && request.resource.data.completedAt == resource.data.completedAt) ||
         (resource.data.status == 'planned' && request.resource.data.completedAt == request.time));
    }
    // Statistics are written only by the trusted Cloud Function.
    match /searchStats/{id} {
      allow read: if request.auth != null && request.auth.token.admin == true;
    }
    match /searchItems/{id} {
      allow read: if request.auth != null && request.auth.token.admin == true;
    }
    match /searchEvents/{id} {
      allow read: if request.auth != null && request.auth.token.admin == true;
    }
    match /reloopUsers/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || request.auth.token.admin == true);
      allow list: if request.auth != null && request.auth.token.admin == true;
      allow create, update: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.keys().hasAll(['name', 'email']) &&
        request.resource.data.keys().hasOnly(['name', 'email']) &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 100 && request.resource.data.email == request.auth.token.email;
    }
  }
}
